# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_APP_URL: Public-facing base URL used by Next.js server components
# (e.g., layout.tsx) when making self-referential fetch calls during SSR.
# Should match APP_URL for production. Defaults to https://lms.yagyaashram.com if not set.
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# Google Merchant API: Required to sync courses as Merchant Center product inputs.
# Create these in Google Cloud/Merchant Center and store production values in PLATFORM_SECRETS.
GOOGLE_MERCHANT_ACCOUNT_ID="MY_MERCHANT_ACCOUNT_ID"
GOOGLE_MERCHANT_DATASOURCE_NAME="accounts/MY_MERCHANT_ACCOUNT_ID/dataSources/MY_DATA_SOURCE_ID"
# Recommended: paste the full downloaded Google service account JSON as one KV value.
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"MY_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMY_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"merchant-sync@MY_PROJECT.iam.gserviceaccount.com","client_id":"..."}'
# Fallback if you do not want to store the full JSON in one key:
GOOGLE_MERCHANT_SERVICE_ACCOUNT_EMAIL="merchant-sync@MY_PROJECT.iam.gserviceaccount.com"
GOOGLE_MERCHANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMY_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Jules API automation.
# Only JULES_API_KEY must be added manually to the PLATFORM_SECRETS KV namespace.
# Create it in the Jules web app Settings page: https://jules.google.com/settings
# After that, use Admin > Error Sessions > Jules API Settings to fetch sources and save the rest.
JULES_API_KEY="YOUR_JULES_API_KEY"

# The following keys are also stored in PLATFORM_SECRETS, but the admin UI can set/update them.
# Source names are fetched server-side from https://jules.googleapis.com/v1alpha/sources using JULES_API_KEY.
JULES_SOURCE_NAME="sources/github/YOUR_GITHUB_ORG/YOUR_REPO"
JULES_STARTING_BRANCH="main"
JULES_AUTOMATION_MODE="AUTO_CREATE_PR"
JULES_REQUIRE_PLAN_APPROVAL="false"
JULES_API_BASE_URL="https://jules.googleapis.com"
JULES_AUTO_SEND_ENABLED="true"

# Firebase FCM Client Config (safe to serve to clients):
# These values are served by /api/firebase/config and used by the Firebase Web SDK.
# Create them in Firebase Console → Project Settings → General → Your apps → Web.
NEXT_PUBLIC_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# Note: The /api/firebase/config endpoint returns these same values from PLATFORM_SECRETS
# (keys: FIREBASE_API_KEY, FCM_PROJECT_ID, FIREBASE_MESSAGING_SENDER_ID, FIREBASE_APP_ID).
# The NEXT_PUBLIC_* vars here are for local dev convenience only — production uses KV secrets.

# JWT Secret: Required for secure HttpOnly cookie session generation and verification.
# CRITICAL: This JWT_SECRET must match the one set in Cloudflare KV PLATFORM_SECRETS
# wrangler kv:key put JWT_SECRET "your-super-secret-jwt-key" --namespace-id=xxx
JWT_SECRET="your-super-secret-jwt-key"
